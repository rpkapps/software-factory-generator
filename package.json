{
  "name": "sfg",
  "version": "0.1.0",
  "description": "Software Factory Generator: a CLI that lets AI agents build reviewable, repeatable software factories out of stations, lines and immutable artifacts.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sfg": "bin/sfg.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sfg": "node src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
